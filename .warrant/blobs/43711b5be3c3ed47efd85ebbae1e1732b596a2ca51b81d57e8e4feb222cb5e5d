## Reproducible independent controls
Run from the pinned checkout with sigma-glyph==0.8.0 and Node available, using a Python environment that also contains Warrant. Put TMPDIR under ~/.warrant.

```python
import sys
from pathlib import Path

sys.path.insert(0, str(Path.cwd()))
import vars1 as V
from test_vars1 import TestVars1Conformance


def check(kind):
    t = TestVars1Conformance()
    t.setUp()
    try:
        inp = t._fuzz_counterexample()
        if kind == "tightening":
            inp = t._fuzz_counterexample(commits=len(inp) + 1)
            t._register_rules(V.H_LENS_KERNEL_V1B,
                              V.Rules(V.RULES[V.H_LENS_KERNEL_V1B].path, "v1"), V.KERNEL1B_ATOM)
        tip, scope = t._core()
        cand, scope, _ = t._change(kind, "core", tip, scope, V.H_LENS_KERNEL_V1B,
                                    label=kind, inp=inp)
        t.repo.admit_and_advance("core", cand, expected_old=tip)
        tip = cand
        for code in (-9, -10):
            assert V.KERNEL1B_ATOM.count(b"\x41\x79") == 1
            raw = V.KERNEL1B_ATOM.replace(b"\x41\x79", bytes((0x41, code & 0x7f)))
            path = Path(t.tmp.name) / f"lens{code}.wasm"
            path.write_bytes(raw)
            h = V.sha256(raw)
            resources = frozenset({-7}) if kind == "hardening" else frozenset({code})
            t._register_rules(h, V.Rules(path, "v1", resources), raw)
            got = V.metered_runner(h).run(inp, t.BUDGET)
            assert got == V.RulesResult("refusal", code=code), got
            cand, scope, _ = t._change("equivalent", "core", tip, scope, h, label=f"new{code}")
            t.repo.admit_and_advance("core", cand, expected_old=tip)
            tip = cand
            print(f"PASS {kind}: real WASM successor {code}, resource={code in resources}, admitted", flush=True)

        chain = t.repo.commit_chain(tip)
        runner = V._METERED[h]
        seen = []

        class Stub:
            result = None

            def run(self, data, budget):
                seen.append((data, budget))
                return self.result

        stub = Stub()
        V._METERED[h] = stub
        try:
            for result in (V.RulesResult("output", output=b"x"), V.RulesResult("exhausted"),
                           V.RulesResult("fault")):
                stub.result = result
                try:
                    t.repo._check_earlier_changes("core", chain, h, b"")
                except V.VarsError as e:
                    assert "no longer refuse its input within its budget" in str(e), e
                else:
                    raise AssertionError(f"(d) admitted {result}")
                assert seen[-1] == (inp, t.BUDGET)
                print(f"PASS {kind}: stub {result.kind} refused, original input/budget observed", flush=True)
            stub.result = V.RulesResult("refusal", code=-11)
            t.repo._check_earlier_changes("core", chain, h, b"")
            assert seen[-1] == (inp, t.BUDGET)
            print(f"PASS {kind}: stub new refusal accepted under original budget", flush=True)
        finally:
            V._METERED[h] = runner
    finally:
        t.tearDown()
        t.doCleanups()


check("hardening")
check("tightening")

```

